```html
{% extends "base.html" %}

{% block title %}Member Dashboard | Library Management System{% endblock %}

{% block content %}

<section class="dashboard">

    <!-- Dashboard Header -->
    <div class="dashboard-header">
        <div>
            <h1>Welcome, {{ member[1] }}!</h1>
            <p>Here is your library account overview.</p>
        </div>
    </div>

    <!-- Member Statistics -->
    <div class="stats-container">

        <div class="stat-card">
            <h3>Borrowed Books</h3>
            <p>{{ stats.get('borrowed', 0) }}</p>
        </div>

        <div class="stat-card">
            <h3>Overdue Books</h3>
            <p>{{ stats.get('overdue', 0) }}</p>
        </div>

        <div class="stat-card">
            <h3>Pending Fine</h3>
            <p>₹{{ "%.2f"|format(stats.get('pending_fine', 0)) }}</p>
        </div>

    </div>

    <!-- Currently Borrowed Books -->
    <section class="dashboard-section">

        <h2>My Currently Borrowed Books</h2>

        {% if issued %}

        <div class="table-container">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Loan ID</th>
                        <th>Book Title</th>
                        <th>Author</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Overdue Days</th>
                        <th>Current Fine</th>
                    </tr>
                </thead>

                <tbody>
                    {% for book in issued %}
                    <tr>
                        <td>{{ book[0] }}</td>
                        <td>{{ book[1] }}</td>
                        <td>{{ book[2] }}</td>
                        <td>{{ book[3] }}</td>
                        <td>{{ book[4] }}</td>
                        <td>{{ book[5] }}</td>
                        <td>{{ book[6] }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% else %}
            <p>You have not borrowed any books currently.</p>
        {% endif %}

    </section>

    <!-- Borrowing History -->
    <section class="dashboard-section">

        <h2>My Borrowing History</h2>

        {% if history %}

        <div class="table-container">
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Loan ID</th>
                        <th>Book</th>
                        <th>Author</th>
                        <th>Issue Date</th>
                        <th>Due Date</th>
                        <th>Return Date</th>
                        <th>Fine</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    {% for item in history %}
                    <tr>
                        <td>{{ item[0] }}</td>
                        <td>{{ item[1] }}</td>
                        <td>{{ item[2] }}</td>
                        <td>{{ item[3] }}</td>
                        <td>{{ item[4] }}</td>
                        <td>{{ item[5] or 'Not Returned' }}</td>
                        <td>₹{{ "%.2f"|format(item[6] or 0) }}</td>
                        <td>{{ item[7] }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% else %}
            <p>No borrowing history found.</p>
        {% endif %}

    </section>

</section>

{% endblock %}
```